<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.heavenlyheat.darren-mait</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>source "$HOME/marketingskills/.env" &amp;&amp; cd "$HOME/marketingskills" &amp;&amp; ./skills/automate-mait-reporting/scripts/mait-pull.sh >> /tmp/darren-mait.log 2>&amp;1</string>
    </array>

    <!-- Daily at 04:00 local time (set your Mac timezone to CT) -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/darren-mait.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/darren-mait-error.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
